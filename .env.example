# Keep the token private. Existing environment variables override .env.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DB_PATH=data/bot.db
# Enable Server Members Intent in Discord Developer Portal before setting true.
WELCOME_ENABLED=false

# Optional self-service roles; disabled unless explicitly enabled.
ROLES_ENABLED=false

# Register commands globally across Discord (shows in bot profile 'Commands' section)
GLOBAL_COMMANDS=false

# Multi-guild mode: allow bot to serve multiple Discord servers with isolated data per server
MULTI_GUILD=false

# Bot activity status shown on profile (e.g. /help, /party, or any text)
BOT_STATUS=/help

